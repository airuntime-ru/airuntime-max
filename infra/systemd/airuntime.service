[Unit]
Description=AIRuntime production stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/airuntime
EnvironmentFile=/home/airuntime/.env
ExecStartPre=/usr/bin/docker compose -f docker-compose.prod.yml pull --ignore-buildable
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
