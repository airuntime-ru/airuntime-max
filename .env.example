DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/airuntime
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me
APP_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development
# DEBUG/INFO/WARNING/ERROR - applies to both the API and worker processes.
LOG_LEVEL=INFO

APP_DOMAIN=airuntime.ru
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# OTP
OTP_EXPIRE_MINUTES=10

# SMTP / transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@airuntime.ru
SMTP_FROM_NAME=AIRuntime
SMTP_REPLY_TO=
SMTP_USE_TLS=true
SUPPORT_EMAIL=support@airuntime.ru
PUBLIC_BASE_DOMAIN=airuntime.ru

PROVIDER_NAME=openai
OPENAI_API_KEY=
# Codex CLI talks here instead of api.openai.com. Empty = official OpenAI.
OPENAI_BASE_URL=https://routerai.ru/api/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional dedicated RouterAI platform key. Empty = reuse OPENAI_API_KEY.
ROUTERAI_API_KEY=
DEFAULT_MODEL_OPENAI=gpt-5.6-sol
DEFAULT_MODEL_ANTHROPIC=claude-sonnet-5
DEFAULT_MODEL_GEMINI=gemini-2.5-pro
DEFAULT_MODEL_OPENROUTER=openai/gpt-5.6-sol
DEFAULT_MODEL_ROUTERAI=openai/gpt-5.6-sol
BILLING_CREDITS_PER_RUB=100
BILLING_USD_TO_RUB=100
CODEX_REASONING_EFFORT=max
CODEX_SIMPLE_TIMEOUT_SECONDS=300
ORCHESTRATION_TASK_DEFAULT_TIMEOUT_SECONDS=1800

# The orchestration engine (planner -> task graph -> specialist roles/skills/MCP -> evidence ->
# validation -> git checkpoint -> deploy) is the only agent path and every capability in it is
# always on - there are no feature flags for any of it. Run `docker compose build preview` once
# so the preview stage has its image; until then preview degrades gracefully, never crashes.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_DOMAIN=airuntime.ru
# Optional — must match backend ANALYTICS_INGEST_KEY when set
NEXT_PUBLIC_ANALYTICS_INGEST_KEY=

ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

DEPLOYMENT_DEFAULT_IMAGE=nginx:alpine
DEPLOYMENT_PORT_BASE=18000

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=airuntime
S3_SECRET_KEY=airuntime-secret
S3_BUCKET=airuntime-files
S3_REGION=us-east-1
S3_MAX_UPLOAD_BYTES=10485760
S3_PRESIGN_EXPIRE_SECONDS=3600

# Product analytics ingest (optional; empty = accept all in dev)
ANALYTICS_INGEST_KEY=

# Robokassa. Result/Success/Fail URLs to paste in the merchant cabinet:
#   Result  POST https://api.airuntime.ru/api/v1/billing/robokassa/result
#   Success GET  https://api.airuntime.ru/api/v1/billing/robokassa/success
#   Fail    GET  https://api.airuntime.ru/api/v1/billing/robokassa/fail
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_PASSWORD3=
ROBOKASSA_TEST_MODE=false
ROBOKASSA_HASH_ALGORITHM=md5

# Ops Telegram bot (infra alerts + deploy notifications)
DEPLOY_HEALTH_GRACE_MINUTES=15
DEPLOY_POST_FINISH_GRACE_MIN=3
AIRUNTIME_TELEGRAM_BOT_TOKEN=
AIRUNTIME_TELEGRAM_CHAT_ID=
AIRUNTIME_TELEGRAM_TOPIC_CODE=
AIRUNTIME_TELEGRAM_TOPIC_CLIENTS=
ERROR_ALERT_THRESHOLD=20
LOG_CHECK_INTERVAL_SEC=600
MONITOR_CONTAINERS=airuntime-backend-1,airuntime-worker-1,airuntime-django-admin-1,airuntime-frontend-1
HEALTH_CHECK_URLS=https://api.airuntime.ru/health,https://admin.airuntime.ru/,https://airuntime.ru/
# RouterAI balance alerts (reuse platform LLM key; empty = disabled)
ROUTERAI_BALANCE_REPORT_HOUR=20
ROUTERAI_LOW_BALANCE_RUB=100
ROUTERAI_BALANCE_CHECK_INTERVAL_SEC=3600

# ---------------------------------------------------------------------------------------
# MAX messenger (chat bot + mini app)
# ---------------------------------------------------------------------------------------
# Token of the bot created on "MAX для партнёров" (platform-api2.max.ru).
MAX_BOT_TOKEN=
# Bot nickname without "@". Deep links are built as https://max.ru/<username>?startapp=<slug>,
# so a wrong value here produces links that open nothing. Check it with GET /me.
MAX_BOT_USERNAME=t403_hakaton_max_bot
# Numeric user_id returned by GET /me; makes open_app buttons reliable across MAX clients.
MAX_BOT_ID=
MAX_API_BASE_URL=https://platform-api2.max.ru
# Unguessable path segment for POST /api/v1/max/webhook/<secret>. MAX does not sign its
# deliveries, so this secret is the only thing authenticating them. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MAX_WEBHOOK_SECRET=
# Where the mini app is served. Empty = <FRONTEND_URL>/max. Must be HTTPS in production.
MAX_MINIAPP_URL=
# Launch parameters older than this are refused (MAX recommends one hour).
MAX_INIT_DATA_MAX_AGE_SECONDS=3600
# platform-api2.max.ru is signed by the Ministry of Digital Development CA, which no default
# trust store carries. The backend image installs it system-wide, so leave this empty there;
# set it only to point at a different bundle. Outside the container the repo copy is used.
MAX_CA_BUNDLE=
# Model for the "describe your business -> storefront" wizard. Storefronts use the same
# high-quality tier as regular AIRuntime generation; this intentionally favours result
# quality and art direction over the lowest possible response time.
MAX_WIZARD_MODEL=openai/gpt-5.6-sol
# Banner on the bot's welcome message; MAX downloads it itself, so it must be public HTTPS.
# Empty = <FRONTEND_URL>/brand/max-welcome-v7.jpg, "-" = send the welcome without a picture.
MAX_WELCOME_IMAGE_URL=
