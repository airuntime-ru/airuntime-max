# Git / VCS
.git
.gitignore
.gitattributes

# Secrets / local env
.env
.env.*
!.env.example

# Dependencies & build artifacts
**/node_modules/
**/.next/
**/__pycache__/
**/.venv/
**/venv/
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/*.egg-info/

# Mail runtime (unix sockets break `docker build` context tar)
infra/mail/data/
infra/mail/state/
infra/mail/config/ssl/
infra/mail/config/postfix-accounts.cf
infra/mail/config/postfix-virtual.cf

# Traefik / certs
infra/traefik/letsencrypt/
letsencrypt/

# Ops / docs / tests not needed in images
/scripts/
/logs/
/output/
*.md
!README.md
.github/
tests/
frontend/docs/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
backend/.email-preview/
admin/staticfiles/
admin/*.sqlite3
