FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY ops_bot/requirements.txt /tmp/ops-bot-requirements.txt
RUN pip install --no-cache-dir -r /tmp/ops-bot-requirements.txt

COPY ops_bot ./ops_bot
COPY docker-entrypoint-ops-bot.sh /docker-entrypoint-ops-bot.sh
RUN sed -i 's/\r$//' /docker-entrypoint-ops-bot.sh \
    && chmod +x /docker-entrypoint-ops-bot.sh

ENV STATE_DIR=/var/lib/ops-bot
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV TZ=Europe/Moscow

VOLUME ["/var/lib/ops-bot"]

ENTRYPOINT ["/docker-entrypoint-ops-bot.sh"]
