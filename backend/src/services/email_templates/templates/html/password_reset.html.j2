{% extends "base.html.j2" %}
{% from "macros.html.j2" import button, security_notice, url_pill %}
{% block body %}
<p style="margin:0;font-family:{{ font_stack }};font-size:16px;line-height:1.55;color:{{ colors.muted }};">Нажмите кнопку ниже, чтобы задать новый пароль. Ссылка одноразовая.</p>
{{ button("Сбросить пароль", reset_url) }}
<p style="margin:14px 0 0;font-family:{{ font_stack }};font-size:13px;line-height:1.5;color:{{ colors.muted }};">Или откройте ссылку:</p>
{{ url_pill(reset_url) }}
{{ security_notice("Ссылка действует " ~ link_ttl ~ ". Если вы не запрашивали сброс, просто проигнорируйте это письмо.") }}
{% endblock %}
