{% extends "base.html.j2" %}
{% from "macros.html.j2" import button, billing_summary, status_badge %}
{% block body %}
<p style="margin:0 0 12px;">{{ status_badge("Скоро обновление", "warning") }}</p>
<p style="margin:0;font-family:{{ font_stack }};font-size:16px;line-height:1.55;color:{{ colors.muted }};">Тарифный период скоро закончится. Баланс обновится автоматически — ничего делать не нужно, если вы остаётесь на текущем тарифе.</p>
{{ billing_summary(summary_rows) }}
{% if billing_url %}{{ button("Управление тарифом", billing_url) }}{% endif %}
{% endblock %}
