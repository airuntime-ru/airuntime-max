{% extends "base.html.j2" %}
{% from "macros.html.j2" import button, billing_summary, status_badge %}
{% block body %}
<p style="margin:0 0 12px;">{{ status_badge("Ожидает оплаты", "warning") }}</p>
<p style="margin:0;font-family:{{ font_stack }};font-size:16px;line-height:1.55;color:{{ colors.muted }};">Счёт на пополнение кредитов создан. Оплатите его по инструкции в личном кабинете — после подтверждения кредиты появятся на балансе.</p>
{{ billing_summary(summary_rows) }}
{% if billing_url %}{{ button("Открыть оплату", billing_url) }}{% endif %}
{% endblock %}
